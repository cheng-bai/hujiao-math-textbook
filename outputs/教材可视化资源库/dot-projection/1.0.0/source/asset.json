  "formula": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mrow><msub><mi>proj</mi><mi>a</mi></msub><mi>b</mi><mo>=</mo><mfrac><mrow><mo>|</mo><mi>b</mi><mo>|</mo><mi>cos</mi><mi>θ</mi></mrow><mrow><mo>|</mo><mi>a</mi><mo>|</mo></mrow></mfrac><mi>a</mi><mo>;</mo><mspace width=\"1em\"/><mi>a</mi><mo>·</mo><mi>b</mi><mo>=</mo><mo>|</mo><mi>a</mi><mo>|</mo><mo>|</mo><mi>b</mi><mo>|</mo><mi>cos</mi><mi>θ</mi></mrow></math>",
